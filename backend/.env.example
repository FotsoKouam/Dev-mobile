# Configuration de la base de données et du serveur backend

# Port d'écoute du serveur HTTP (défaut: 3000)
PORT=3000

# -----------------------------------------------------------------------------
# Options de connexion à PostgreSQL (choisir l'une des deux options)
# -----------------------------------------------------------------------------

# Option 1 : Base locale Docker (voir docker-compose.yml à la racine)
# Démarrer : docker compose up -d
# Arrêter en conservant les données : docker compose down
# Tout effacer (y compris le volume) : docker compose down -v
#
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_db
DATABASE_SSL=false

# Option 2 : Base hébergée (Neon, SSL obligatoire)
# DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/nom_de_la_base
# DATABASE_SSL=true

# -----------------------------------------------------------------------------
# Authentification Google OAuth
# -----------------------------------------------------------------------------

# Identifiant client OAuth Google. Renseigné dans .env local et dans les variables Render, jamais committé avec une vraie valeur.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# Authentification JWT et Sessions
# -----------------------------------------------------------------------------

JWT_ACCESS_SECRET=change-me-local-only-access-secret
JWT_REFRESH_SECRET=change-me-local-only-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Mot de passe initial des administrateurs, utilisé uniquement par le seed
ADMIN_SEED_PASSWORD=change-me-local-only
